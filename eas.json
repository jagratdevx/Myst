{
  "cli": {
    "version": ">= 19.0.6",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GROQ_API_KEY": "$GROQ_API_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GROQ_API_KEY": "$GROQ_API_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
